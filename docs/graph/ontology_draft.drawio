<mxfile host="app.diagrams.net"><diagram name="Ontology" id="ontology"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1260" pageHeight="880"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="grp" value="Equipment &amp; destinations (possible CURRENTLY_AT / TRIGGERED_BY / ABOUT targets)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontColor=#666666;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="1180" height="290" as="geometry"/></mxCell><mxCell id="W" value="&lt;b&gt;Warehouse&lt;/b&gt;&lt;hr&gt;warehouse_id = WH_01, name, status&lt;br&gt;run_id (active run), run_ids&lt;br&gt;simulator_status&lt;br&gt;&lt;i&gt;kpi_* (calculated by Member 4)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="500" y="20" width="280" height="110" as="geometry"/></mxCell><mxCell id="C" value="&lt;b&gt;Conveyor&lt;/b&gt;&lt;hr&gt;conveyor_id = CONVEYOR_01&lt;br&gt;speed_mps, running, jammed&lt;br&gt;status, jammed_since, stopped_since" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="230" height="110" as="geometry"/></mxCell><mxCell id="SC" value="&lt;b&gt;Scanner&lt;/b&gt;&lt;hr&gt;scanner_id = SCANNER_01&lt;br&gt;status&lt;br&gt;successful_scans, failed_scans" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="370" y="240" width="220" height="110" as="geometry"/></mxCell><mxCell id="SO" value="&lt;b&gt;Sorter&lt;/b&gt;&lt;hr&gt;sorter_id = SORTER_01&lt;br&gt;status, active_rout