ometry"/></mxCell><mxCell id="e18" value="ABOUT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;labelBackgroundColor=#FFFFFF;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="T" target="P"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="ABOUT (equipment / bay)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="T" target="grp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• 10 entity types (agreement §7)&lt;br&gt;• Alert TRIGGERED_BY and simulator_status ABOUT may also target the Warehouse&lt;br&gt;• Parcel states only move forward: created → scanned → at_sorter → sorted | rejected → dispatched&lt;br&gt;• Unique constraints: event_id, (run_id, parcel_id), every equipment id, alert_id" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="760" width="560" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>